# Grant Assistant — environment variables
# Copy to .env and fill in your real values. Never commit the real .env file.

# ── Database ───────────────────────────────────────────────────
# Leave unset to use the default local H2 file database.
# For PostgreSQL set all four:
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=

# ── LLM provider ───────────────────────────────────────────────
# openai_compat  → real OpenAI-compatible API (DeepSeek, Groq, etc.)
# mock           → built-in deterministic mock (no API key needed)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── File upload ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ── Server (used by hosting platform; local dev defaults to 8080) ──
PORT=8080
